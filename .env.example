# ---- Next.js app -------------------------------------------------------------
# The one shared password (checked by /api/auth/login) and the JWT signing secret
APP_PASSWORD=change-me
AUTH_SECRET=change-me-to-a-long-random-string
# The Python compute API: its origin and shared key (= BEBOP_API_KEY below)
ENGINE_URL=http://127.0.0.1:8000
ENGINE_API_KEY=change-me-too
# Turso (libSQL). Leave TURSO_DATABASE_URL unset locally to use file:./data/logs/bebop.db
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# ---- Python compute API (api/) -----------------------------------------------
BEBOP_API_KEY=change-me-too
BEBOP_ALLOWED_ORIGINS=http://localhost:3000
BEBOP_MAX_LAYOUTS=2000
BEBOP_TIME_BUDGET_MS=6000
BEBOP_DEV=1
# Score -> Tab vision reader (Python only; never commit a real key)
ANTHROPIC_API_KEY=
