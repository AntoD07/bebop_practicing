{
  "name": "bebop (Next.js + Python API)",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.12-bookworm",
  "features": {
    "ghcr.io/devcontainers/features/node:1": { "version": "24" }
  },
  "customizations": {
    "vscode": {
      "extensions": ["ms-python.python", "ms-python.vscode-pylance", "dbaeumer.vscode-eslint", "bradlc.vscode-tailwindcss"]
    }
  },
  "updateContentCommand": "pip install uv && uv sync && npm install && cp -n .env.example .env.local || true",
  "postAttachCommand": {
    "api": "BEBOP_DEV=1 uv run uvicorn api.index:app --port 8000 --reload",
    "web": "npm run dev"
  },
  "forwardPorts": [3000, 8000],
  "portsAttributes": {
    "3000": { "label": "Next.js", "onAutoForward": "openPreview" },
    "8000": { "label": "Python API" }
  }
}
